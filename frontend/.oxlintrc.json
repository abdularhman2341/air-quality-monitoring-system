{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "eslint/max-lines": [
      "error",
      {
        "max": 400
      }
    ],
    "eslint/max-lines-per-function": [
      "warn",
      {
        "max": 25,
        "skipBlankLines": true,
        "skipComments": true
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "tests/**"
      ],
      "rules": {
        "eslint/max-lines-per-function": "off"
      }
    }
  ]
}

exports[`AuthLayout > renders the same markup in both languages 1`] = `"<div class="auth"><aside class="auth-hero"><div class="auth-brand"><div class="auth-logo"><img alt="Gas Monitor logo" height="40" src="data:image/svg+xml,%3csvg%20width='51'%20height='51'%20viewBox='0%200%2051%2051'%20fill='none'%20xmlns='http://www.w3.org/2000/svg'%3e%3cpath%20d='M48.5155%2025.3311C48.5155%2038.1355%2038.1355%2048.5155%2025.3311%2048.5155C12.5267%2048.5155%202.14673%2038.1355%202.14673%2025.3311C2.14673%2012.5267%2012.5267%202.14673%2025.3311%202.14673C38.1355%202.14673%2048.5155%2012.5267%2048.5155%2025.3311Z'%20stroke-width='4.2934'%20stroke='%23197653'/%3e%3cpath%20d='M38.6406%206.35425C41.9787%208.68519%2044.6441%2011.8541%2046.3688%2015.5421'%20stroke-width='4.2934'%20stroke-linecap='round'%20stroke='%23197653'/%3e%3cpath%20d='M46.3688%2015.5421C47.4982%2017.9793%2048.1956%2020.5943%2048.4296%2023.2703'%20stroke-width='4.2934'%20stroke-linecap='round'%20stroke='%23197653'/%3e%3cpath%20d='M6.44019%2025.3311H11.5923M12.4509%2011.5922L16.7444%2015.8856M25.3312%204.72278V10.7335M38.2114%2011.5922L33.918%2015.8856M39.07%2025.3311H44.2221'%20stroke-width='2.1467'%20stroke-linecap='round'%20stroke='%23173D31'/%3e%3cpath%20d='M25.3311%2046.7981C19.3203%2046.7981%2015.8856%2042.9341%2015.8856%2037.782C15.8856%2033.7462%2018.2899%2030.7408%2021.8964%2027.7354C21.467%2030.9125%2023.0985%2032.7158%2025.1594%2033.9179C27.5637%2031.0843%2028.68%2028.5941%2028.3365%2025.1594C32.8016%2029.1093%2035.6353%2033.0592%2035.6353%2037.8678C35.6353%2042.934%2031.7712%2046.7981%2025.3311%2046.7981Z'%20fill='%232F8F6C'/%3e%3cpath%20d='M25.3311%2043.3634C22.4116%2043.3634%2020.6084%2041.4743%2020.6084%2038.8983C20.6084%2036.9233%2021.7247%2035.2918%2023.442%2033.7462C23.2703%2035.6353%2024.2149%2036.8374%2025.3311%2037.5244C26.5333%2036.0646%2027.2202%2034.7766%2027.0485%2033.0592C29.3669%2035.2918%2030.4832%2037.1809%2030.4832%2039.2417C30.4832%2041.646%2028.5941%2043.3634%2025.3311%2043.3634Z'%20fill='%238BC8AE'/%3e%3cpath%20d='M25.3311%2025.3311L38.2113%2013.3096'%20stroke-width='3.43472'%20stroke-linecap='round'%20stroke='%232B8A68'/%3e%3cpath%20d='M25.3311%2029.6245C27.7023%2029.6245%2029.6245%2027.7023%2029.6245%2025.3311C29.6245%2022.9599%2027.7023%2021.0377%2025.3311%2021.0377C22.9599%2021.0377%2021.0377%2022.9599%2021.0377%2025.3311C21.0377%2027.7023%2022.9599%2029.6245%2025.3311%2029.6245Z'%20fill='%23173D31'/%3e%3c/svg%3e" width="40"></div><div><div class="auth-brand-name">Gas Monitor</div><div class="auth-brand-tagline">LPG LEAK MONITORING</div></div></div><div class="auth-pitch"><h1>Know the moment gas starts to leak</h1><p>Gas Monitor reads the LPG level in your kitchen and sounds a local alarm when it passes the safe limit</p></div><ul class="auth-facts"><li><span class="auth-fact-dot"></span>Local alarm works without internet</li><li><span class="auth-fact-dot"></span>Live readings from every sensor</li><li><span class="auth-fact-dot"></span>Full alert history</li></ul></aside><section class="auth-panel"><div class="auth-panel-top"><div aria-label="Language" class="lang-switch" role="group"><button aria-pressed="true" type="button">EN</button><button aria-pressed="false" type="button">عربي</button></div></div><div class="auth-panel-body"><div class="auth-form"><p>form</p></div></div></section></div><div role="status"></div>"`;

exports[`AuthLayout > renders the same markup in both languages 2`] = `"<div class="auth"><aside class="auth-hero"><div class="auth-brand"><div class="auth-logo"><img alt="Gas Monitor logo" height="40" src="data:image/svg+xml,%3csvg%20width='51'%20height='51'%20viewBox='0%200%2051%2051'%20fill='none'%20xmlns='http://www.w3.org/2000/svg'%3e%3cpath%20d='M48.5155%2025.3311C48.5155%2038.1355%2038.1355%2048.5155%2025.3311%2048.5155C12.5267%2048.5155%202.14673%2038.1355%202.14673%2025.3311C2.14673%2012.5267%2012.5267%202.14673%2025.3311%202.14673C38.1355%202.14673%2048.5155%2012.5267%2048.5155%2025.3311Z'%20stroke-width='4.2934'%20stroke='%23197653'/%3e%3cpath%20d='M38.6406%206.35425C41.9787%208.68519%2044.6441%2011.8541%2046.3688%2015.5421'%20stroke-width='4.2934'%20stroke-linecap='round'%20stroke='%23197653'/%3e%3cpath%20d='M46.3688%2015.5421C47.4982%2017.9793%2048.1956%2020.5943%2048.4296%2023.2703'%20stroke-width='4.2934'%20stroke-linecap='round'%20stroke='%23197653'/%3e%3cpath%20d='M6.44019%2025.3311H11.5923M12.4509%2011.5922L16.7444%2015.8856M25.3312%204.72278V10.7335M38.2114%2011.5922L33.918%2015.8856M39.07%2025.3311H44.2221'%20stroke-width='2.1467'%20stroke-linecap='round'%20stroke='%23173D31'/%3e%3cpath%20d='M25.3311%2046.7981C19.3203%2046.7981%2015.8856%2042.9341%2015.8856%2037.782C15.8856%2033.7462%2018.2899%2030.7408%2021.8964%2027.7354C21.467%2030.9125%2023.0985%2032.7158%2025.1594%2033.9179C27.5637%2031.0843%2028.68%2028.5941%2028.3365%2025.1594C32.8016%2029.1093%2035.6353%2033.0592%2035.6353%2037.8678C35.6353%2042.934%2031.7712%2046.7981%2025.3311%2046.7981Z'%20fill='%232F8F6C'/%3e%3cpath%20d='M25.3311%2043.3634C22.4116%2043.3634%2020.6084%2041.4743%2020.6084%2038.8983C20.6084%2036.9233%2021.7247%2035.2918%2023.442%2033.7462C23.2703%2035.6353%2024.2149%2036.8374%2025.3311%2037.5244C26.5333%2036.0646%2027.2202%2034.7766%2027.0485%2033.0592C29.3669%2035.2918%2030.4832%2037.1809%2030.4832%2039.2417C30.4832%2041.646%2028.5941%2043.3634%2025.3311%2043.3634Z'%20fill='%238BC8AE'/%3e%3cpath%20d='M25.3311%2025.3311L38.2113%2013.3096'%20stroke-width='3.43472'%20stroke-linecap='round'%20stroke='%232B8A68'/%3e%3cpath%20d='M25.3311%2029.6245C27.7023%2029.6245%2029.6245%2027.7023%2029.6245%2025.3311C29.6245%2022.9599%2027.7023%2021.0377%2025.3311%2021.0377C22.9599%2021.0377%2021.0377%2022.9599%2021.0377%2025.3311C21.0377%2027.7023%2022.9599%2029.6245%2025.3311%2029.6245Z'%20fill='%23173D31'/%3e%3c/svg%3e" width="40"></div><div><div class="auth-brand-name">Gas Monitor</div><div class="auth-brand-tagline">مراقبة تسرّب الغاز</div></div></div><div class="auth-pitch"><h1>اعرف لحظة بدء تسرّب الغاز</h1><p>يقيس Gas Monitor مستوى غاز البترول المسال في مطبخك ويطلق إنذاراً محلياً إذا تجاوز الحد الآمن</p></div><ul class="auth-facts"><li><span class="auth-fact-dot"></span>الإنذار المحلي يعمل بدون إنترنت</li><li><span class="auth-fact-dot"></span>قراءات مباشرة من كل حساس</li><li><span class="auth-fact-dot"></span>سجل كامل للتنبيهات</li></ul></aside><section class="auth-panel"><div class="auth-panel-top"><div aria-label="اللغة" class="lang-switch" role="group"><button aria-pressed="false" type="button">EN</button><button aria-pressed="true" type="button">عربي</button></div></div><div class="auth-panel-body"><div class="auth-form"><p>form</p></div></div></section></div><div role="status"></div>"`;

exports[`ForgotPassword > asks for a code with the trimmed email, then shows the code step and the wait 1`] = `"<h2>Enter the code</h2><p class="subtitle">If this email has an account, we sent a code to <bdi class="auth-email" dir="ltr">sara@example.com</bdi></p><form class="form"><label class="field">Code<input aria-describedby="code-hint" autocomplete="one-time-code" class="code-input" dir="ltr" inputmode="numeric" placeholder="000000" required="" type="text" value=""><span class="field-hint" id="code-hint">6 digits. It works once and expires after 15 minutes.</span></label><label class="field">New password<input aria-describedby="password-hint" aria-invalid="false" autocomplete="new-password" required="" type="password" value=""><span class="field-hint" id="password-hint">8+ characters</span></label><label class="field">Confirm password<input aria-invalid="false" autocomplete="new-password" required="" type="password" value=""></label><button class="btn btn-primary" disabled="" type="submit">Change password</button></form><p class="auth-switch"><span>New code in 60s</span> · <button class="link-button" type="button">Use another email</button></p><div role="status"></div>"`;

exports[`ForgotPassword > renders the email step the same 1`] = `"<h2>Forgot password</h2><p class="subtitle">Enter your email and we will send you a 6-digit code</p><form class="form"><label class="field">Email<input autocomplete="email" dir="ltr" required="" type="email" value=""></label><button class="btn btn-primary" type="submit">Send code</button></form><p class="auth-switch"><a data-discover="true" href="/login">Back to sign in</a></p><div role="status"></div>"`;

exports[`Login > an account that was never activated goes to the code step, and Back returns 1`] = `"<h2>Activate your account</h2><p class="subtitle">Enter the 6-digit code we sent to <bdi dir="ltr">sara@example.com</bdi></p><form class="code-form"><div class="code-form-row"><input aria-invalid="false" aria-label="Verification code" autocomplete="one-time-code" class="code-form-input" dir="ltr" id="activate-code" inputmode="numeric" placeholder="000000" type="text" value=""><button class="btn btn-primary" disabled="" type="submit">Activate</button><button class="link-button" type="button">Send a new code</button></div></form><p class="auth-switch"><button class="link-button" type="button">Back</button></p><div role="status"></div>"`;

exports[`Login > renders the same markup, with the reset notice and email from the reset page 1`] = `"<h2>Sign in</h2><p class="subtitle">Sign in to see your sensors</p><p class="form-success" role="status">Your password was changed. Sign in with the new password.</p><form class="form"><label class="field">Email<input autocomplete="email" dir="ltr" required="" type="email" value="sara@example.com"></label><label class="field">Password<input autocomplete="current-password" required="" type="password" value=""></label><a class="auth-forgot" data-discover="true" href="/forgot-password">Forgot password?</a><button class="btn btn-primary" type="submit">Sign in</button></form><p class="auth-switch">Don't have an account? <a data-discover="true" href="/signup">Create one</a></p><div role="status"></div>"`;

exports[`Login > shows the server error and frees the button 1`] = `"<p class="form-error" role="alert">البريد الإلكتروني أو كلمة المرور غير صحيحة.</p>"`;

exports[`Signup > checks a short password without a request, and typing clears the message 1`] = `"<form class="form"><label class="field">Name<input autocomplete="name" maxlength="100" required="" type="text" value="Sara"></label><label class="field">Email<input autocomplete="email" dir="ltr" required="" type="email" value="sara@example.com"></label><label class="field">Password<input aria-describedby="password-hint password-error" aria-invalid="true" autocomplete="new-password" required="" type="password" value="short"><span class="field-hint" id="password-hint">8+ characters</span></label><label class="field">Confirm password<input aria-invalid="false" autocomplete="new-password" required="" type="password" value="short"></label><p class="form-error" id="password-error" role="alert">Password must be at least 8 characters.</p><button class="btn btn-primary" type="submit">Sign up</button></form>"`;

exports[`Signup > renders the same markup 1`] = `"<h2>Create account</h2><p class="subtitle">Create an account to link your sensors</p><form class="form"><label class="field">Name<input autocomplete="name" maxlength="100" required="" type="text" value=""></label><label class="field">Email<input autocomplete="email" dir="ltr" required="" type="email" value=""></label><label class="field">Password<input aria-describedby="password-hint" aria-invalid="false" autocomplete="new-password" required="" type="password" value=""><span class="field-hint" id="password-hint">8+ characters</span></label><label class="field">Confirm password<input aria-invalid="false" autocomplete="new-password" required="" type="password" value=""></label><button class="btn btn-primary" type="submit">Sign up</button></form><p class="auth-switch">Already have an account? <a data-discover="true" href="/login">Sign in</a></p><div role="status"></div>"`;

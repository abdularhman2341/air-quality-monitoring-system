// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Profile page > checks the new password before sending it 1`] = `"<div class="profile-section"><h2>Password</h2><p>Changing your password signs out every other device. You stay signed in here.</p><form class="form profile-subform"><label class="field">Current password<input autocomplete="current-password" required="" type="password" value=""></label><label class="field">New password<input autocomplete="new-password" aria-invalid="false" aria-describedby="new-password-hint" required="" type="password" value=""><span class="field-hint" id="new-password-hint">8+ characters</span></label><label class="field">Confirm password<input autocomplete="new-password" aria-invalid="false" required="" type="password" value=""></label><div class="profile-actions profile-actions-end"><button type="button" class="btn btn-outline">Cancel</button><button type="submit" class="btn btn-primary" disabled="">Change password</button></div></form></div>"`;

exports[`Profile page > deletes the account after the password, and shows an error on failure 1`] = `"<section class="danger-zone"><h2>Delete account</h2><p>Your account is deleted permanently. Your sensors are unlinked and all their readings and alerts are deleted. This cannot be undone.</p><form class="form profile-subform"><label class="field">Current password<input autocomplete="current-password" maxlength="72" required="" type="password" value=""></label><div class="profile-actions profile-actions-end"><button type="button" class="btn btn-outline">Cancel</button><button type="submit" class="btn btn-danger" disabled="">Delete permanently</button></div></form></section>"`;

exports[`Profile page > refuses the current email without asking the server 1`] = `"<form class="form profile-subform"><label class="field">New email<input autocomplete="email" dir="ltr" required="" type="email" value=""></label><label class="field">Current password<input autocomplete="current-password" maxlength="72" required="" type="password" value=""></label><div class="profile-actions profile-actions-end"><button type="button" class="btn btn-outline">Cancel</button><button type="submit" class="btn btn-primary" disabled="">Save email</button></div></form>"`;

exports[`Profile page > renders the same markup in Arabic 1`] = `"<section class="card profile-card"><div class="profile-head"><span class="profile-avatar">S</span><div><h1>الملف الشخصي</h1><div class="profile-since">عضو منذ 1 أكتوبر 2026</div></div></div><form class="form"><label class="field">الاسم<input autocomplete="name" maxlength="100" required="" type="text" value="Sara"></label><div class="profile-actions"><button type="button" class="btn btn-danger-outline">تسجيل الخروج</button><button type="submit" class="btn btn-primary" disabled="">حفظ</button></div></form><div class="profile-section"><div class="field">البريد الإلكتروني<div class="email-row"><div class="readonly-value" dir="ltr">sara@example.com</div><button type="button" class="btn btn-outline">تغيير</button></div></div></div><div class="profile-section"><h2>تنبيهات الغاز على البريد</h2><p>تصلك رسالة عند بدء الإنذار في أحد حساساتك وعند انتهائه. الإنذار الصوتي في الحساس يبقى هو الأساس.</p><label class="switch-row"><input role="switch" class="switch" type="checkbox" checked=""><span>أرسل لي تنبيهات الغاز على البريد</span></label></div><div class="profile-section"><h2>كلمة المرور</h2><p>تغيير كلمة المرور يسجّل الخروج من كل الأجهزة الأخرى. وتبقى مسجّلاً هنا.</p><button type="button" class="btn btn-outline">تغيير كلمة المرور…</button></div><div class="profile-section"><h2>تسجيل الخروج من كل الأجهزة</h2><p>تُنهى كل جلسات حسابك على كل الأجهزة، ومنها أي أحد يستخدم دخولاً منسوخاً. وتبقى مسجّلاً هنا.</p><button type="button" class="btn btn-outline">تسجيل الخروج من كل الأجهزة…</button></div><section class="danger-zone"><h2>حذف الحساب</h2><p>سيُحذف حسابك نهائياً، ويُلغى ربط حساساتك وتُحذف كل قراءاتها وتنبيهاتها. لا يمكن التراجع عن ذلك.</p><button type="button" class="btn btn-danger-outline">حذف الحساب…</button></section></section>"`;

exports[`Profile page > renders the same markup in English 1`] = `"<section class="card profile-card"><div class="profile-head"><span class="profile-avatar">S</span><div><h1>Profile</h1><div class="profile-since">Member since 1 October 2026</div></div></div><form class="form"><label class="field">Name<input autocomplete="name" maxlength="100" required="" type="text" value="Sara"></label><div class="profile-actions"><button type="button" class="btn btn-danger-outline">Log Out</button><button type="submit" class="btn btn-primary" disabled="">Save</button></div></form><div class="profile-section"><div class="field">Email<div class="email-row"><div class="readonly-value" dir="ltr">sara@example.com</div><button type="button" class="btn btn-outline">Change</button></div></div></div><div class="profile-section"><h2>Gas alert emails</h2><p>Get an email when one of your sensors starts an alarm and when it ends. The buzzer on the sensor is still the main alarm.</p><label class="switch-row"><input role="switch" class="switch" type="checkbox" checked=""><span>Email me about gas alerts</span></label></div><div class="profile-section"><h2>Password</h2><p>Changing your password signs out every other device. You stay signed in here.</p><button type="button" class="btn btn-outline">Change password…</button></div><div class="profile-section"><h2>Sign out of all devices</h2><p>Ends every session of your account on every device, including anyone using a copied sign-in. You stay signed in here.</p><button type="button" class="btn btn-outline">Sign out of all devices…</button></div><section class="danger-zone"><h2>Delete account</h2><p>Your account is deleted permanently. Your sensors are unlinked and all their readings and alerts are deleted. This cannot be undone.</p><button type="button" class="btn btn-danger-outline">Delete account…</button></section></section>"`;

exports[`Profile page > shows a pending email with its code form, and can cancel it 1`] = `"<div class="pending-email"><div class="pending-email-head"><span class="chip chip-warn">Waiting for the code</span><bdi dir="ltr">new@example.com</bdi></div><p>We sent a code to this address. Your email stays the same until you enter it.</p><form class="code-form"><div class="code-form-row"><input id="change-email-code" class="code-form-input" inputmode="numeric" autocomplete="one-time-code" dir="ltr" placeholder="000000" aria-label="Verification code" aria-invalid="false" type="text" value=""><button type="submit" class="btn btn-primary" disabled="">Confirm email</button><button type="button" class="link-button">Send a new code</button></div></form><button type="button" class="link-button pending-email-cancel">Cancel the change</button></div>"`;

exports[`Profile page > signs out other devices with the password 1`] = `"<div class="profile-section"><h2>Sign out of all devices</h2><p>Ends every session of your account on every device, including anyone using a copied sign-in. You stay signed in here.</p><form class="form profile-subform"><label class="field">Current password<input autocomplete="current-password" required="" type="password" value=""></label><div class="profile-actions profile-actions-end"><button type="button" class="btn btn-outline">Cancel</button><button type="submit" class="btn btn-primary" disabled="">Sign out everywhere</button></div></form></div>"`;

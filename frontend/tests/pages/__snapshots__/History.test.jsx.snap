exports[`History alerts tab > renders the same page in English and Arabic 1`] = `"<div class="history"><div class="page-head"><div><h1>History &amp; Alerts</h1><p>Leak episodes and raw readings for your sensors</p></div><div class="segmented" role="tablist"><button aria-selected="true" role="tab" type="button">Alerts</button><button aria-selected="false" role="tab" type="button">Readings</button></div></div><div class="filters card"><label class="filter-device">Device<select><option value="all">All devices</option><option value="A4CF123B9E01">Kitchen</option><option value="A4CF123B9E7F">A4:CF:12:3B:9E:7F</option></select></label><div class="filter-range">Period<div class="range-buttons"><button aria-pressed="false" type="button">24 h</button><button aria-pressed="false" type="button">7 days</button><button aria-pressed="true" type="button">30 days</button></div></div><button class="btn btn-outline export" type="button">Export CSV</button></div><div class="table-card card"><table><thead><tr><th>Device</th><th>Started</th><th>Duration</th><th class="num">Peak (ppm)</th><th>Status</th></tr></thead><tbody><tr><td class="strong">Kitchen</td><td class="muted">21 Nov, 11:30</td><td class="muted">Ongoing</td><td class="num strong danger">1,450</td><td><span class="chip chip-danger">Active</span></td></tr><tr><td class="strong">A4:CF:12:3B:9E:7F</td><td class="muted">20 Nov, 08:00</td><td class="muted">1 h 5 min</td><td class="num strong ">1,200</td><td><span class="chip chip-neutral">Ended</span></td></tr><tr><td class="strong">FFFFFFFFFFFF</td><td class="muted">19 Nov, 08:00</td><td class="muted">42 s</td><td class="num strong ">1,010</td><td><span class="chip chip-neutral">Ended</span></td></tr></tbody></table></div></div>"`;


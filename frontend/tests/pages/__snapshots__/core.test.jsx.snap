exports[`LanguageProvider > starts from the saved language, translates, and saves a switch 1`] = `"en | en-GB | New code in 5s | nope.key | New code in {seconds}s | Bad code | x"`;

exports[`LanguageProvider > starts from the saved language, translates, and saves a switch 2`] = `"ar | ar-u-nu-latn | رمز جديد بعد 5 ث | nope.key | رمز جديد بعد {seconds} ث | الرمز غير صحيح أو انتهت صلاحيته. اطلب رمزاً جديداً. | حدث خطأ غير متوقع. حاول مرة أخرى."`;

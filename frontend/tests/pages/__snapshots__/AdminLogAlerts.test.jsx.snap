exports[`AdminAlerts > asks before ending an alert; cancel goes back 1`] = `"<tbody><tr><td><div class="strong">Kitchen</div><div class="mono" dir="ltr">A4CF123B9E01</div></td><td class="muted" dir="ltr">sara@example.com</td><td class="muted">21 Nov, 11:30</td><td class="muted">Ongoing</td><td class="num strong danger">1,450</td><td><button class="btn btn-danger-outline" type="button">End alert</button></td></tr><tr><td><div class="strong">—</div><div class="mono" dir="ltr">A4CF123B9E7F</div></td><td class="muted">No owner</td><td class="muted">20 Nov, 08:00</td><td class="muted">Ongoing</td><td class="num strong danger">1,100</td><td><button class="btn btn-danger-outline" disabled="" type="button">End alert</button></td></tr><tr class="admin-panel-row"><td colspan="6"><div aria-label="End the alert of A4CF123B9E7F now? Do this only if you are sure there is no leak." class="admin-confirm" role="alertdialog"><p>End the alert of A4CF123B9E7F now? Do this only if you are sure there is no leak.</p><div class="admin-confirm-actions"><button class="btn btn-outline" type="button">Cancel</button><button class="btn btn-danger" type="button">End alert</button></div></div></td></tr><tr><td><div class="strong">—</div><div class="mono" dir="ltr">A4CF123B9E55</div></td><td class="muted">No owner</td><td class="muted">19 Nov, 08:00</td><td class="muted">5 min 0 s</td><td class="num strong ">1,010</td><td><span class="chip chip-neutral">Ended</span></td></tr></tbody>"`;

exports[`AdminAlerts > opens on the open alerts, the same in English and Arabic 1`] = `"<div class="admin-toolbar"><div class="range-buttons"><button aria-pressed="true" type="button">Still open</button><button aria-pressed="false" type="button">All</button></div><p class="admin-muted">End an alert by hand only when the device never reported the end of the alarm.</p></div><div class="table-card card"><table><thead><tr><th>Device</th><th>Owner</th><th>Started</th><th>Duration</th><th class="num">Peak (ppm)</th><th>Status</th></tr></thead><tbody><tr><td><div class="strong">Kitchen</div><div class="mono" dir="ltr">A4CF123B9E01</div></td><td class="muted" dir="ltr">sara@example.com</td><td class="muted">21 Nov, 11:30</td><td class="muted">Ongoing</td><td class="num strong danger">1,450</td><td><button class="btn btn-danger-outline" type="button">End alert</button></td></tr><tr><td><div class="strong">—</div><div class="mono" dir="ltr">A4CF123B9E7F</div></td><td class="muted">No owner</td><td class="muted">20 Nov, 08:00</td><td class="muted">Ongoing</td><td class="num strong danger">1,100</td><td><button class="btn btn-danger-outline" type="button">End alert</button></td></tr><tr><td><div class="strong">—</div><div class="mono" dir="ltr">A4CF123B9E55</div></td><td class="muted">No owner</td><td class="muted">19 Nov, 08:00</td><td class="muted">5 min 0 s</td><td class="num strong ">1,010</td><td><span class="chip chip-neutral">Ended</span></td></tr></tbody></table></div><div role="status"></div>"`;

exports[`AdminAlerts > opens on the open alerts, the same in English and Arabic 2`] = `"<div class="admin-toolbar"><div class="range-buttons"><button aria-pressed="true" type="button">المفتوحة</button><button aria-pressed="false" type="button">الكل</button></div><p class="admin-muted">أنهِ التنبيه يدوياً فقط إذا لم يرسل الجهاز نهاية الإنذار.</p></div><div class="table-card card"><table><thead><tr><th>الجهاز</th><th>المالك</th><th>البداية</th><th>المدة</th><th class="num">الذروة (ppm)</th><th>الحالة</th></tr></thead><tbody><tr><td><div class="strong">Kitchen</div><div class="mono" dir="ltr">A4CF123B9E01</div></td><td class="muted" dir="ltr">sara@example.com</td><td class="muted">21 نوفمبر، 11:30</td><td class="muted">مستمر</td><td class="num strong danger">1,450</td><td><button class="btn btn-danger-outline" type="button">إنهاء التنبيه</button></td></tr><tr><td><div class="strong">—</div><div class="mono" dir="ltr">A4CF123B9E7F</div></td><td class="muted">بدون مالك</td><td class="muted">20 نوفمبر، 08:00</td><td class="muted">مستمر</td><td class="num strong danger">1,100</td><td><button class="btn btn-danger-outline" type="button">إنهاء التنبيه</button></td></tr><tr><td><div class="strong">—</div><div class="mono" dir="ltr">A4CF123B9E55</div></td><td class="muted">بدون مالك</td><td class="muted">19 نوفمبر، 08:00</td><td class="muted">5 د 0 ث</td><td class="num strong ">1,010</td><td><span class="chip chip-neutral">انتهى</span></td></tr></tbody></table></div><div role="status"></div>"`;


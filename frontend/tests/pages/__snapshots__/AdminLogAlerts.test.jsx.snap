exports[`AdminLog > renders every kind of detail the same in English and Arabic 1`] = `"<div class="table-card card"><table><thead><tr><th>Time</th><th>By</th><th>Action</th><th>Target</th><th>Details</th></tr></thead><tbody><tr><td class="muted">21 Nov, 10:00:00</td><td class="muted" dir="ltr">root@example.com</td><td class="strong">Edited device</td><td><div class="strong" dir="auto">Kitchen</div><div class="mono" dir="ltr">device A4CF123B9E01</div></td><td class="admin-log-details"><span>Name: <bdi>Kitchen</bdi> → <bdi>مطبخ</bdi></span><span> · Owner: <bdi>—</bdi> → <bdi>sara@example.com</bdi></span><span> · history deleted</span></td></tr><tr><td class="muted">20 Nov, 10:00:00</td><td class="muted" dir="ltr">root@example.com</td><td class="strong">Deleted device</td><td><div class="mono" dir="ltr">device A4CF123B9E7F</div></td><td class="admin-log-details"><span>Owner: <bdi>sara@example.com</bdi></span><span> · Location: <bdi>—</bdi></span></td></tr><tr><td class="muted">19 Nov, 10:00:00</td><td class="muted">make-admin script</td><td class="strong">Made admin</td><td><div class="strong" dir="auto">Sara</div><div class="mono" dir="ltr">user 7</div></td><td class="admin-log-details"></td></tr><tr><td class="muted">18 Nov, 10:00:00</td><td class="muted" dir="ltr">root@example.com</td><td class="strong">Ended alert</td><td><div class="strong" dir="auto">Kitchen</div><div class="mono" dir="ltr">alert 12</div></td><td class="admin-log-details"><span>Role: <bdi>user</bdi> → <bdi>admin</bdi></span></td></tr></tbody></table></div><div role="status"></div>"`;

exports[`AdminLog > renders every kind of detail the same in English and Arabic 2`] = `"<div class="table-card card"><table><thead><tr><th>الوقت</th><th>بواسطة</th><th>الإجراء</th><th>الهدف</th><th>التفاصيل</th></tr></thead><tbody><tr><td class="muted">21 نوفمبر، 10:00:00</td><td class="muted" dir="ltr">root@example.com</td><td class="strong">تعديل جهاز</td><td><div class="strong" dir="auto">Kitchen</div><div class="mono" dir="ltr">device A4CF123B9E01</div></td><td class="admin-log-details"><span>الاسم: <bdi>Kitchen</bdi> ← <bdi>مطبخ</bdi></span><span> · المالك: <bdi>—</bdi> ← <bdi>sara@example.com</bdi></span><span> · حُذف السجل</span></td></tr><tr><td class="muted">20 نوفمبر، 10:00:00</td><td class="muted" dir="ltr">root@example.com</td><td class="strong">حذف جهاز</td><td><div class="mono" dir="ltr">device A4CF123B9E7F</div></td><td class="admin-log-details"><span>المالك: <bdi>sara@example.com</bdi></span><span> · الموقع: <bdi>—</bdi></span></td></tr><tr><td class="muted">19 نوفمبر، 10:00:00</td><td class="muted">سكربت make-admin</td><td class="strong">ترقية إلى مدير</td><td><div class="strong" dir="auto">Sara</div><div class="mono" dir="ltr">user 7</div></td><td class="admin-log-details"></td></tr><tr><td class="muted">18 نوفمبر، 10:00:00</td><td class="muted" dir="ltr">root@example.com</td><td class="strong">إنهاء تنبيه</td><td><div class="strong" dir="auto">Kitchen</div><div class="mono" dir="ltr">alert 12</div></td><td class="admin-log-details"><span>الصلاحية: <bdi>user</bdi> ← <bdi>admin</bdi></span></td></tr></tbody></table></div><div role="status"></div>"`;

exports[`PairingCodeBox > shows the code once and copies it 1`] = `"<div class="pairing-box" role="status"><div class="pairing-label">Pairing code for A4:CF:12:3B:9E:01</div><div class="pairing-code" dir="ltr">482913</div><p>Write it down or copy it now. It will not be shown again; only a new code can replace it.</p><p>The device's broker account in Mosquitto is still added by hand.</p><div class="admin-confirm-actions"><button class="btn btn-outline" type="button">Copy code</button><button class="btn btn-primary" type="button">Done</button></div></div><div role="status"></div>"`;

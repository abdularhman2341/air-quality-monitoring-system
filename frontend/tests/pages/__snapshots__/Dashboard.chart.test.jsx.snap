// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Dashboard readings chart > draws the readings oldest first with the safe colors, in English and Arabic 1`] = `"<section class="card readings-card"><div class="readings-head"><h3>Recent Readings</h3><span>Last 3 readings</span><span class="legend"><span class="legend-line"></span>Threshold 1,000 ppm</span></div><div class="chart" dir="ltr"><div data-part="ResponsiveContainer" data-props="{&quot;height&quot;:260,&quot;width&quot;:&quot;100%&quot;}"><div data-part="AreaChart" data-props="{&quot;data&quot;:[{&quot;ppm&quot;:118,&quot;time&quot;:&quot;2026-11-21T11:57:00Z&quot;},{&quot;ppm&quot;:2600,&quot;time&quot;:&quot;2026-11-21T11:58:00Z&quot;},{&quot;ppm&quot;:120,&quot;time&quot;:&quot;2026-11-21T11:59:00Z&quot;}],&quot;margin&quot;:{&quot;bottom&quot;:0,&quot;left&quot;:0,&quot;right&quot;:8,&quot;top&quot;:8}}"><div data-part="CartesianGrid" data-props="{&quot;stroke&quot;:&quot;#f0f1f3&quot;,&quot;vertical&quot;:false}"></div><div data-part="XAxis" data-props="{&quot;axisLine&quot;:{&quot;stroke&quot;:&quot;var(--border)&quot;},&quot;dataKey&quot;:&quot;time&quot;,&quot;minTickGap&quot;:40,&quot;tick&quot;:{&quot;fill&quot;:&quot;var(--text-faint)&quot;,&quot;fontSize&quot;:11},&quot;tickFormatter&quot;:&quot;fn(\\&quot;11:59:00\\&quot; | \\&quot;1 Jan, 00:00:01\\&quot;)&quot;,&quot;tickLine&quot;:false}"></div><div data-part="YAxis" data-props="{&quot;axisLine&quot;:false,&quot;domain&quot;:[0,2600],&quot;tick&quot;:{&quot;fill&quot;:&quot;var(--text-faint)&quot;,&quot;fontSize&quot;:11},&quot;tickFormatter&quot;:&quot;fn(\\&quot;NaN\\&quot; | \\&quot;1,234\\&quot;)&quot;,&quot;tickLine&quot;:false,&quot;ticks&quot;:[0,600,1200,1800],&quot;width&quot;:44}"></div><div data-part="Tooltip" data-props="{&quot;formatter&quot;:&quot;fn([\\&quot;NaN ppm\\&quot;,\\&quot;\\&quot;] | [\\&quot;1,234 ppm\\&quot;,\\&quot;\\&quot;])&quot;,&quot;labelFormatter&quot;:&quot;fn(\\&quot;11:59:00\\&quot; | \\&quot;1 Jan, 00:00:01\\&quot;)&quot;,&quot;separator&quot;:&quot;&quot;}"></div><div data-part="ReferenceLine" data-props="{&quot;stroke&quot;:&quot;var(--text)&quot;,&quot;strokeDasharray&quot;:&quot;5 5&quot;,&quot;y&quot;:1000}"></div><div data-part="Area" data-props="{&quot;dataKey&quot;:&quot;ppm&quot;,&quot;fill&quot;:&quot;rgba(47, 143, 108, 0.12)&quot;,&quot;isAnimationActive&quot;:false,&quot;stroke&quot;:&quot;var(--safe-ink)&quot;,&quot;strokeWidth&quot;:2.5,&quot;type&quot;:&quot;monotone&quot;}"></div></div></div></div><p class="estimate-note">Values are estimates. The sensor has not been calibrated against a reference instrument yet.</p></section>"`;

exports[`Dashboard readings chart > draws the readings oldest first with the safe colors, in English and Arabic 2`] = `"<section class="card readings-card"><div class="readings-head"><h3>القراءات الأخيرة</h3><span>آخر 3 قراءة</span><span class="legend"><span class="legend-line"></span>الحد 1,000 ppm</span></div><div class="chart" dir="ltr"><div data-part="ResponsiveContainer" data-props="{&quot;height&quot;:260,&quot;width&quot;:&quot;100%&quot;}"><div data-part="AreaChart" data-props="{&quot;data&quot;:[{&quot;ppm&quot;:118,&quot;time&quot;:&quot;2026-11-21T11:57:00Z&quot;},{&quot;ppm&quot;:2600,&quot;time&quot;:&quot;2026-11-21T11:58:00Z&quot;},{&quot;ppm&quot;:120,&quot;time&quot;:&quot;2026-11-21T11:59:00Z&quot;}],&quot;margin&quot;:{&quot;bottom&quot;:0,&quot;left&quot;:0,&quot;right&quot;:8,&quot;top&quot;:8}}"><div data-part="CartesianGrid" data-props="{&quot;stroke&quot;:&quot;#f0f1f3&quot;,&quot;vertical&quot;:false}"></div><div data-part="XAxis" data-props="{&quot;axisLine&quot;:{&quot;stroke&quot;:&quot;var(--border)&quot;},&quot;dataKey&quot;:&quot;time&quot;,&quot;minTickGap&quot;:40,&quot;tick&quot;:{&quot;fill&quot;:&quot;var(--text-faint)&quot;,&quot;fontSize&quot;:11},&quot;tickFormatter&quot;:&quot;fn(\\&quot;11:59:00\\&quot; | \\&quot;1 يناير، 00:00:01\\&quot;)&quot;,&quot;tickLine&quot;:false}"></div><div data-part="YAxis" data-props="{&quot;axisLine&quot;:false,&quot;domain&quot;:[0,2600],&quot;tick&quot;:{&quot;fill&quot;:&quot;var(--text-faint)&quot;,&quot;fontSize&quot;:11},&quot;tickFormatter&quot;:&quot;fn(\\&quot;NaN\\&quot; | \\&quot;1,234\\&quot;)&quot;,&quot;tickLine&quot;:false,&quot;ticks&quot;:[0,600,1200,1800],&quot;width&quot;:44}"></div><div data-part="Tooltip" data-props="{&quot;formatter&quot;:&quot;fn([\\&quot;NaN ppm\\&quot;,\\&quot;\\&quot;] | [\\&quot;1,234 ppm\\&quot;,\\&quot;\\&quot;])&quot;,&quot;labelFormatter&quot;:&quot;fn(\\&quot;11:59:00\\&quot; | \\&quot;1 يناير، 00:00:01\\&quot;)&quot;,&quot;separator&quot;:&quot;&quot;}"></div><div data-part="ReferenceLine" data-props="{&quot;stroke&quot;:&quot;var(--text)&quot;,&quot;strokeDasharray&quot;:&quot;5 5&quot;,&quot;y&quot;:1000}"></div><div data-part="Area" data-props="{&quot;dataKey&quot;:&quot;ppm&quot;,&quot;fill&quot;:&quot;rgba(47, 143, 108, 0.12)&quot;,&quot;isAnimationActive&quot;:false,&quot;stroke&quot;:&quot;var(--safe-ink)&quot;,&quot;strokeWidth&quot;:2.5,&quot;type&quot;:&quot;monotone&quot;}"></div></div></div></div><p class="estimate-note">القيم تقديرية. لم تتم معايرة الحساس مقابل جهاز مرجعي بعد.</p></section>"`;

exports[`Dashboard readings chart > takes the alert colors when the device is in an alarm 1`] = `"<section class="card readings-card"><div class="readings-head"><h3>Recent Readings</h3><span>Last 3 readings</span><span class="legend"><span class="legend-line"></span>Threshold 1,000 ppm</span></div><div class="chart" dir="ltr"><div data-part="ResponsiveContainer" data-props="{&quot;height&quot;:260,&quot;width&quot;:&quot;100%&quot;}"><div data-part="AreaChart" data-props="{&quot;data&quot;:[{&quot;ppm&quot;:118,&quot;time&quot;:&quot;2026-11-21T11:57:00Z&quot;},{&quot;ppm&quot;:2600,&quot;time&quot;:&quot;2026-11-21T11:58:00Z&quot;},{&quot;ppm&quot;:120,&quot;time&quot;:&quot;2026-11-21T11:59:00Z&quot;}],&quot;margin&quot;:{&quot;bottom&quot;:0,&quot;left&quot;:0,&quot;right&quot;:8,&quot;top&quot;:8}}"><div data-part="CartesianGrid" data-props="{&quot;stroke&quot;:&quot;#f0f1f3&quot;,&quot;vertical&quot;:false}"></div><div data-part="XAxis" data-props="{&quot;axisLine&quot;:{&quot;stroke&quot;:&quot;var(--border)&quot;},&quot;dataKey&quot;:&quot;time&quot;,&quot;minTickGap&quot;:40,&quot;tick&quot;:{&quot;fill&quot;:&quot;var(--text-faint)&quot;,&quot;fontSize&quot;:11},&quot;tickFormatter&quot;:&quot;fn(\\&quot;11:59:00\\&quot; | \\&quot;1 Jan, 00:00:01\\&quot;)&quot;,&quot;tickLine&quot;:false}"></div><div data-part="YAxis" data-props="{&quot;axisLine&quot;:false,&quot;domain&quot;:[0,2600],&quot;tick&quot;:{&quot;fill&quot;:&quot;var(--text-faint)&quot;,&quot;fontSize&quot;:11},&quot;tickFormatter&quot;:&quot;fn(\\&quot;NaN\\&quot; | \\&quot;1,234\\&quot;)&quot;,&quot;tickLine&quot;:false,&quot;ticks&quot;:[0,600,1200,1800],&quot;width&quot;:44}"></div><div data-part="Tooltip" data-props="{&quot;formatter&quot;:&quot;fn([\\&quot;NaN ppm\\&quot;,\\&quot;\\&quot;] | [\\&quot;1,234 ppm\\&quot;,\\&quot;\\&quot;])&quot;,&quot;labelFormatter&quot;:&quot;fn(\\&quot;11:59:00\\&quot; | \\&quot;1 Jan, 00:00:01\\&quot;)&quot;,&quot;separator&quot;:&quot;&quot;}"></div><div data-part="ReferenceLine" data-props="{&quot;stroke&quot;:&quot;var(--text)&quot;,&quot;strokeDasharray&quot;:&quot;5 5&quot;,&quot;y&quot;:1000}"></div><div data-part="Area" data-props="{&quot;dataKey&quot;:&quot;ppm&quot;,&quot;fill&quot;:&quot;rgba(185, 28, 28, 0.10)&quot;,&quot;isAnimationActive&quot;:false,&quot;stroke&quot;:&quot;var(--danger-ink)&quot;,&quot;strokeWidth&quot;:2.5,&quot;type&quot;:&quot;monotone&quot;}"></div></div></div></div><p class="estimate-note">Values are estimates. The sensor has not been calibrated against a reference instrument yet.</p></section>"`;

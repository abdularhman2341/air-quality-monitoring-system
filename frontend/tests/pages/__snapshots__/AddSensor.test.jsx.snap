// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`AddSensor form > a server error shows its text; only INVALID_MAC marks the MAC field 1`] = `"mac_address must be 12 hex characters."`;

exports[`AddSensor form > a server error shows its text; only INVALID_MAC marks the MAC field 2`] = `"Device is already linked to another account."`;

exports[`AddSensor form > renders the same page in English and Arabic 1`] = `"<div class="add-sensor"><div class="card add-sensor-card"><h1>Add Sensor</h1><p class="subtitle">Enter the MAC address and pairing code printed on your sensor.</p><form class="form" novalidate=""><label class="field">MAC address<input aria-invalid="false" class="mono-input" dir="ltr" maxlength="17" placeholder="A4:CF:12:3B:9E:01" type="text" value=""></label><label class="field">Pairing code<input class="mono-input code-input" dir="ltr" maxlength="32" placeholder="482913" type="text" value=""></label><label class="field">Name<input maxlength="100" placeholder="Kitchen" type="text" value=""></label><label class="field">Location (optional)<input maxlength="150" type="text" value=""></label><div class="form-actions"><a class="btn btn-outline" data-discover="true" href="/">Cancel</a><button class="btn btn-primary" type="submit">Add Sensor</button></div></form></div><div class="add-sensor-side"><div class="card my-sensors"><h2>My sensors</h2><ul class="sensor-list"><li class="sensor-row"><div class="sensor-info"><div class="sensor-name">Kitchen</div><div class="sensor-mac" dir="ltr">A4:CF:12:3B:9E:01</div></div><button class="btn btn-danger-outline" type="button">Remove</button></li><li class="sensor-row"><div class="sensor-info"><div class="sensor-name">Garage</div><div class="sensor-mac" dir="ltr">A4:CF:12:3B:9E:7F</div></div><button class="btn btn-danger-outline" type="button">Remove</button></li></ul></div><ol class="add-steps"><li><span class="step-number">1</span><div><div class="step-title">Power on the sensor</div><div class="step-body">It joins Wi-Fi on its own and shows Online once linked.</div></div></li><li><span class="step-number">2</span><div><div class="step-title">Find the label</div><div class="step-body">The MAC address and pairing code are printed on the back of the device.</div></div></li><li><span class="step-number">3</span><div><div class="step-title">One account per sensor</div><div class="step-body">If it is linked to another account, the owner must unlink it first.</div></div></li></ol></div></div><div role="status"></div>"`;

exports[`AddSensor form > renders the same page in English and Arabic 2`] = `"<div class="add-sensor"><div class="card add-sensor-card"><h1>إضافة حساس</h1><p class="subtitle">أدخل عنوان MAC ورمز الاقتران المطبوعين على الحساس.</p><form class="form" novalidate=""><label class="field">عنوان MAC<input aria-invalid="false" class="mono-input" dir="ltr" maxlength="17" placeholder="A4:CF:12:3B:9E:01" type="text" value=""></label><label class="field">رمز الاقتران<input class="mono-input code-input" dir="ltr" maxlength="32" placeholder="482913" type="text" value=""></label><label class="field">الاسم<input maxlength="100" placeholder="المطبخ" type="text" value=""></label><label class="field">الموقع (اختياري)<input maxlength="150" type="text" value=""></label><div class="form-actions"><a class="btn btn-outline" data-discover="true" href="/">إلغاء</a><button class="btn btn-primary" type="submit">إضافة حساس</button></div></form></div><div class="add-sensor-side"><div class="card my-sensors"><h2>حساساتي</h2><ul class="sensor-list"><li class="sensor-row"><div class="sensor-info"><div class="sensor-name">Kitchen</div><div class="sensor-mac" dir="ltr">A4:CF:12:3B:9E:01</div></div><button class="btn btn-danger-outline" type="button">حذف</button></li><li class="sensor-row"><div class="sensor-info"><div class="sensor-name">Garage</div><div class="sensor-mac" dir="ltr">A4:CF:12:3B:9E:7F</div></div><button class="btn btn-danger-outline" type="button">حذف</button></li></ul></div><ol class="add-steps"><li><span class="step-number">1</span><div><div class="step-title">شغّل الحساس</div><div class="step-body">يتصل بالواي فاي تلقائياً وتظهر حالته «متصل» بعد الربط.</div></div></li><li><span class="step-number">2</span><div><div class="step-title">ابحث عن الملصق</div><div class="step-body">عنوان MAC ورمز الاقتران مطبوعان على ظهر الجهاز.</div></div></li><li><span class="step-number">3</span><div><div class="step-title">حساب واحد لكل حساس</div><div class="step-body">إذا كان مرتبطاً بحساب آخر، يجب على المالك إلغاء ربطه أولاً.</div></div></li></ol></div></div><div role="status"></div>"`;

exports[`AddSensor my sensors > a failed remove keeps the question open with the error; asking again clears it 1`] = `"Device not found."`;

exports[`AddSensor my sensors > asks before removing, and cancel goes back 1`] = `"<div class="card my-sensors"><h2>My sensors</h2><ul class="sensor-list"><li class="sensor-row"><div class="sensor-info"><div class="sensor-name">Kitchen</div><div class="sensor-mac" dir="ltr">A4:CF:12:3B:9E:01</div></div><button class="btn btn-danger-outline" type="button">Remove</button></li><li class="sensor-row"><div class="sensor-info"><div class="sensor-name">Garage</div><div class="sensor-mac" dir="ltr">A4:CF:12:3B:9E:7F</div></div><div class="sensor-confirm"><p>Remove “Garage”? Its readings and alerts will be deleted. You can add it again later with its pairing code.</p><div class="sensor-confirm-actions"><button class="btn btn-outline" type="button">Cancel</button><button class="btn btn-danger" type="button">Remove</button></div></div></li></ul></div>"`;

exports[`AddSensor my sensors > shows loading, then the list; an empty list and a failed list say so 1`] = `"<div class="card my-sensors"><h2>My sensors</h2><p class="form-error" role="alert">Database is unavailable.</p></div>"`;

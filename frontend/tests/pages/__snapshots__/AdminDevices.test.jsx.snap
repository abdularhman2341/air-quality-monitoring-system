// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`AdminDevices list > renders the register form and the devices the same in English and Arabic 1`] = `"<form class="card admin-register" novalidate=""><h2>Register a new device</h2><div class="admin-register-fields"><label class="field">MAC address<input aria-invalid="false" class="mono-input" dir="ltr" maxlength="17" placeholder="A4:CF:12:3B:9E:01" value=""></label><label class="field">Name<input maxlength="100" value=""></label><label class="field">Location (optional)<input maxlength="150" value=""></label><button class="btn btn-primary" disabled="" type="submit">Register</button></div></form><div class="admin-toolbar"><form class="admin-search" role="search"><input aria-label="MAC, name, location or owner email" maxlength="100" placeholder="MAC, name, location or owner email" type="search" value=""><button class="btn btn-outline" type="submit">Search</button></form></div><div class="table-card card"><table><thead><tr><th>Device</th><th>Owner</th><th>Status</th><th class="num">ppm (estimated)</th><th>Last reading</th><th aria-label="Manage"></th></tr></thead><tbody><tr><td><div class="strong">Kitchen</div><div class="mono" dir="ltr">A4:CF:12:3B:9E:01</div></td><td class="muted" dir="ltr">sara@example.com</td><td><span class="chip chip-safe">Online</span></td><td class="num danger strong">1,300</td><td class="muted">21 Nov, 11:59</td><td class="admin-manage-cell"><button aria-expanded="false" class="btn btn-outline" type="button">Manage</button></td></tr><tr><td><div class="strong">—</div><div class="mono" dir="ltr">A4:CF:12:3B:9E:7F</div></td><td class="muted">No owner</td><td><span class="chip chip-neutral">Offline</span></td><td class="num ">—</td><td class="muted">—</td><td class="admin-manage-cell"><button aria-expanded="false" class="btn btn-outline" type="button">Manage</button></td></tr></tbody></table></div>"`;

exports[`AdminDevices list > renders the register form and the devices the same in English and Arabic 2`] = `"<form class="card admin-register" novalidate=""><h2>تسجيل جهاز جديد</h2><div class="admin-register-fields"><label class="field">عنوان MAC<input aria-invalid="false" class="mono-input" dir="ltr" maxlength="17" placeholder="A4:CF:12:3B:9E:01" value=""></label><label class="field">الاسم<input maxlength="100" value=""></label><label class="field">الموقع (اختياري)<input maxlength="150" value=""></label><button class="btn btn-primary" disabled="" type="submit">تسجيل</button></div></form><div class="admin-toolbar"><form class="admin-search" role="search"><input aria-label="MAC أو الاسم أو الموقع أو بريد المالك" maxlength="100" placeholder="MAC أو الاسم أو الموقع أو بريد المالك" type="search" value=""><button class="btn btn-outline" type="submit">بحث</button></form></div><div class="table-card card"><table><thead><tr><th>الجهاز</th><th>المالك</th><th>الحالة</th><th class="num">جزء في المليون (تقديري)</th><th>آخر قراءة</th><th aria-label="إدارة"></th></tr></thead><tbody><tr><td><div class="strong">Kitchen</div><div class="mono" dir="ltr">A4:CF:12:3B:9E:01</div></td><td class="muted" dir="ltr">sara@example.com</td><td><span class="chip chip-safe">متصل</span></td><td class="num danger strong">1,300</td><td class="muted">21 نوفمبر، 11:59</td><td class="admin-manage-cell"><button aria-expanded="false" class="btn btn-outline" type="button">إدارة</button></td></tr><tr><td><div class="strong">—</div><div class="mono" dir="ltr">A4:CF:12:3B:9E:7F</div></td><td class="muted">بدون مالك</td><td><span class="chip chip-neutral">غير متصل</span></td><td class="num ">—</td><td class="muted">—</td><td class="admin-manage-cell"><button aria-expanded="false" class="btn btn-outline" type="button">إدارة</button></td></tr></tbody></table></div>"`;

exports[`AdminDevices list > says loading, then no match; a failed list shows its error and ADMIN_ONLY re-reads the account 1`] = `"<div class="table-card card"><p class="table-message" role="alert">Admins only.</p></div>"`;

exports[`AdminDevices panel > a new pairing code asks, replaces the panel until Done, and does not reload 1`] = `"<div class="pairing-box" role="status"><div class="pairing-label">Pairing code for A4:CF:12:3B:9E:01</div><div class="pairing-code" dir="ltr">111222</div><p>Write it down or copy it now. It will not be shown again; only a new code can replace it.</p><p>The device's broker account in Mosquitto is still added by hand.</p><div class="admin-confirm-actions"><button class="btn btn-outline" type="button">Copy code</button><button class="btn btn-primary" type="button">Done</button></div></div>"`;

exports[`AdminDevices panel > deletes after the question, says so, closes and reloads; the buttons wait 1`] = `"Delete A4:CF:12:3B:9E:7F with all its readings and alerts? It must be registered again before anyone can link it."`;

exports[`AdminDevices panel > opens with the owner list (first 200 accounts); the select waits for it 1`] = `"<tbody><tr class="admin-row-open"><td><div class="strong">Kitchen</div><div class="mono" dir="ltr">A4:CF:12:3B:9E:01</div></td><td class="muted" dir="ltr">sara@example.com</td><td><span class="chip chip-safe">Online</span></td><td class="num danger strong">1,300</td><td class="muted">21 Nov, 11:59</td><td class="admin-manage-cell"><button aria-expanded="true" class="btn btn-outline" type="button">Close</button></td></tr><tr class="admin-panel-row"><td colspan="6"><div class="admin-panel"><form class="admin-form" novalidate=""><label class="field">Name<input maxlength="100" value="Kitchen"></label><label class="field">Location (optional)<input maxlength="150" value="Floor 1"></label><label class="field">Owner<select><option value="">No owner</option><option value="7">Sara — sara@example.com</option><option value="8">Omar — omar@example.com</option></select></label><div class="admin-form-actions"><button class="btn btn-primary" type="submit">Save</button></div></form><div class="admin-danger-actions"><button class="btn btn-outline" type="button">Last readings</button><button class="btn btn-outline" type="button">New pairing code</button><button class="btn btn-danger-outline" type="button">Delete device</button></div></div></td></tr><tr><td><div class="strong">—</div><div class="mono" dir="ltr">A4:CF:12:3B:9E:7F</div></td><td class="muted">No owner</td><td><span class="chip chip-neutral">Offline</span></td><td class="num ">—</td><td class="muted">—</td><td class="admin-manage-cell"><button aria-expanded="false" class="btn btn-outline" type="button">Manage</button></td></tr></tbody>"`;

exports[`AdminDevices panel > shows the last 10 readings in the panel, or says there are none 1`] = `"<div class="admin-subsection"><h3>Last 10 readings</h3><ul class="admin-device-list"><li><span class="muted">21 Nov, 11:59:00</span><span class="strong danger">1,300 ppm</span></li><li><span class="muted">21 Nov, 11:58:00</span><span class="strong safe">120 ppm</span></li></ul></div>"`;

exports[`AdminDevices panel > taking a device from its owner asks first and warns about the history 1`] = `"<div class="admin-panel"><form class="admin-form" novalidate=""><label class="field">Name<input maxlength="100" value="Kitchen"></label><label class="field">Location (optional)<input maxlength="150" value="Floor 1"></label><label class="field">Owner<select><option value="">No owner</option><option value="7">Sara — sara@example.com</option><option value="8">Omar — omar@example.com</option></select></label><div class="admin-form-actions"><button class="btn btn-primary" type="submit">Save</button></div></form><p class="field-hint">Changing the owner deletes this device's readings and alerts, so the new owner starts empty.</p><div class="admin-danger-actions"><button class="btn btn-outline" type="button">Last readings</button><button class="btn btn-outline" type="button">New pairing code</button><button class="btn btn-danger-outline" type="button">Delete device</button></div></div>"`;

exports[`AdminDevices panel > taking a device from its owner asks first and warns about the history 2`] = `"Move Kitchen to another owner? Its readings and alerts will be deleted. This cannot be undone."`;

exports[`AdminDevices register > needs a MAC, sends the trimmed fields, shows the code once and reloads 1`] = `"<div class="pairing-box" role="status"><div class="pairing-label">Pairing code for A4:CF:12:3B:9E:99</div><div class="pairing-code" dir="ltr">735104</div><p>Write it down or copy it now. It will not be shown again; only a new code can replace it.</p><p>The device's broker account in Mosquitto is still added by hand.</p><div class="admin-confirm-actions"><button class="btn btn-outline" type="button">Copy code</button><button class="btn btn-primary" type="button">Done</button></div></div>"`;

exports[`AdminUsers panel > editing yourself re-reads your account, and demoting yourself warns first 1`] = `"<p class="field-hint">You are removing your own admin role. You will lose access to this page after saving.</p>"`;

exports[`AdminUsers panel > opens one account with its devices; Close closes it 1`] = `"<tbody><tr><td class="strong">Root<span class="admin-you">You</span></td><td class="muted"><span dir="ltr">root@example.com</span></td><td><span class="chip chip-safe">Admin</span></td><td class="num">0</td><td class="muted">1 October 2026</td><td class="admin-manage-cell"><button aria-expanded="false" class="btn btn-outline" type="button">Manage</button></td></tr><tr class="admin-row-open"><td class="strong">Sara</td><td class="muted"><span dir="ltr">sara@example.com</span><span class="chip chip-warn admin-unverified">Not verified</span></td><td><span class="chip chip-neutral">User</span></td><td class="num">2</td><td class="muted">5 October 2026</td><td class="admin-manage-cell"><button aria-expanded="true" class="btn btn-outline" type="button">Close</button></td></tr><tr class="admin-panel-row"><td colspan="6"><div class="admin-panel"><form class="admin-form" novalidate=""><label class="field">Name<input maxlength="100" value="Sara"></label><label class="field">Email<input dir="ltr" type="email" value="sara@example.com"></label><label class="field">Role<select><option value="user">User</option><option value="admin">Admin</option></select></label><div class="admin-form-actions"><button class="btn btn-primary" type="submit">Save</button></div></form><div class="admin-subsection"><h3>Devices of this account</h3><ul class="admin-device-list"><li><span class="strong">Kitchen</span><span class="mono" dir="ltr">A4:CF:12:3B:9E:01</span></li><li><span class="strong">—</span><span class="mono" dir="ltr">A4:CF:12:3B:9E:7F</span></li></ul></div><div class="admin-danger-actions"><button class="btn btn-outline" type="button">Mark email as verified</button><button class="btn btn-outline" type="button">Send password reset code</button><button class="btn btn-outline" type="button">Sign out of all devices</button><button class="btn btn-danger-outline" type="button">Delete account</button></div></div></td></tr><tr><td class="strong">عمر</td><td class="muted"><span dir="ltr">omar@example.com</span></td><td><span class="chip chip-safe">Admin</span></td><td class="num">1</td><td class="muted">1 November 2026</td><td class="admin-manage-cell"><button aria-expanded="false" class="btn btn-outline" type="button">Manage</button></td></tr></tbody>"`;


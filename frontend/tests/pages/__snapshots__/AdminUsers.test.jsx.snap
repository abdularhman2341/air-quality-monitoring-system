exports[`AdminUsers actions > Delete account: asks, sends, says so, closes and reloads 1`] = `"<div aria-label="Delete Sara's account? Their devices will be released and their readings and alerts deleted. This cannot be undone." class="admin-confirm" role="alertdialog"><p>Delete Sara's account? Their devices will be released and their readings and alerts deleted. This cannot be undone.</p><div class="admin-confirm-actions"><button class="btn btn-outline" type="button">Cancel</button><button class="btn btn-danger" type="button">Delete account</button></div></div>"`;

exports[`AdminUsers actions > Mark email as verified: asks, sends, says so, closes and reloads 1`] = `"<div aria-label="Mark sara@example.com as verified without a code? Do this only if you are sure the address belongs to this person." class="admin-confirm admin-confirm-neutral" role="alertdialog"><p>Mark sara@example.com as verified without a code? Do this only if you are sure the address belongs to this person.</p><div class="admin-confirm-actions"><button class="btn btn-outline" type="button">Cancel</button><button class="btn btn-primary" type="button">Mark email as verified</button></div></div>"`;

exports[`AdminUsers actions > Send password reset code: asks, sends, says so, closes and reloads 1`] = `"<div aria-label="Email a password reset code to sara@example.com? They choose the new password themselves." class="admin-confirm admin-confirm-neutral" role="alertdialog"><p>Email a password reset code to sara@example.com? They choose the new password themselves.</p><div class="admin-confirm-actions"><button class="btn btn-outline" type="button">Cancel</button><button class="btn btn-primary" type="button">Send password reset code</button></div></div>"`;

exports[`AdminUsers actions > Sign out of all devices: asks, sends, says so, closes and reloads 1`] = `"<div aria-label="Sign Sara out of every device? They will need to sign in again." class="admin-confirm" role="alertdialog"><p>Sign Sara out of every device? They will need to sign in again.</p><div class="admin-confirm-actions"><button class="btn btn-outline" type="button">Cancel</button><button class="btn btn-danger" type="button">Sign out of all devices</button></div></div>"`;

exports[`AdminUsers actions > on your own account the questions say so, and verifying re-reads your account 1`] = `"Sign yourself out of every device, including this one?"`;

exports[`AdminUsers actions > on your own account the questions say so, and verifying re-reads your account 2`] = `"Delete your own account? You will be signed out. This cannot be undone."`;

exports[`AdminUsers actions > shows mark verified only for an unverified email 1`] = `"<div class="admin-danger-actions"><button class="btn btn-outline" type="button">Mark email as verified</button><button class="btn btn-outline" type="button">Send password reset code</button><button class="btn btn-outline" type="button">Sign out of all devices</button><button class="btn btn-danger-outline" type="button">Delete account</button></div>"`;

exports[`AdminUsers list > renders the accounts the same in English and Arabic 1`] = `"<div class="admin-toolbar"><form class="admin-search" role="search"><input aria-label="Name or email" maxlength="100" placeholder="Name or email" type="search" value=""><button class="btn btn-outline" type="submit">Search</button></form></div><div class="table-card card"><table><thead><tr><th>Name</th><th>Email</th><th>Role</th><th class="num">Devices</th><th>Joined</th><th aria-label="Manage"></th></tr></thead><tbody><tr><td class="strong">Root<span class="admin-you">You</span></td><td class="muted"><span dir="ltr">root@example.com</span></td><td><span class="chip chip-safe">Admin</span></td><td class="num">0</td><td class="muted">1 October 2026</td><td class="admin-manage-cell"><button aria-expanded="false" class="btn btn-outline" type="button">Manage</button></td></tr><tr><td class="strong">Sara</td><td class="muted"><span dir="ltr">sara@example.com</span><span class="chip chip-warn admin-unverified">Not verified</span></td><td><span class="chip chip-neutral">User</span></td><td class="num">2</td><td class="muted">5 October 2026</td><td class="admin-manage-cell"><button aria-expanded="false" class="btn btn-outline" type="button">Manage</button></td></tr><tr><td class="strong">عمر</td><td class="muted"><span dir="ltr">omar@example.com</span></td><td><span class="chip chip-safe">Admin</span></td><td class="num">1</td><td class="muted">1 November 2026</td><td class="admin-manage-cell"><button aria-expanded="false" class="btn btn-outline" type="button">Manage</button></td></tr></tbody></table></div><div role="status"></div>"`;

exports[`AdminUsers list > renders the accounts the same in English and Arabic 2`] = `"<div class="admin-toolbar"><form class="admin-search" role="search"><input aria-label="الاسم أو البريد" maxlength="100" placeholder="الاسم أو البريد" type="search" value=""><button class="btn btn-outline" type="submit">بحث</button></form></div><div class="table-card card"><table><thead><tr><th>الاسم</th><th>البريد الإلكتروني</th><th>الصلاحية</th><th class="num">الأجهزة</th><th>تاريخ التسجيل</th><th aria-label="إدارة"></th></tr></thead><tbody><tr><td class="strong">Root<span class="admin-you">أنت</span></td><td class="muted"><span dir="ltr">root@example.com</span></td><td><span class="chip chip-safe">مدير</span></td><td class="num">0</td><td class="muted">1 أكتوبر 2026</td><td class="admin-manage-cell"><button aria-expanded="false" class="btn btn-outline" type="button">إدارة</button></td></tr><tr><td class="strong">Sara</td><td class="muted"><span dir="ltr">sara@example.com</span><span class="chip chip-warn admin-unverified">غير متحقق</span></td><td><span class="chip chip-neutral">مستخدم</span></td><td class="num">2</td><td class="muted">5 أكتوبر 2026</td><td class="admin-manage-cell"><button aria-expanded="false" class="btn btn-outline" type="button">إدارة</button></td></tr><tr><td class="strong">عمر</td><td class="muted"><span dir="ltr">omar@example.com</span></td><td><span class="chip chip-safe">مدير</span></td><td class="num">1</td><td class="muted">1 نوفمبر 2026</td><td class="admin-manage-cell"><button aria-expanded="false" class="btn btn-outline" type="button">إدارة</button></td></tr></tbody></table></div><div role="status"></div>"`;


// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Dashboard > no devices shows the empty state, and a failed list shows the error 1`] = `"<section class="empty-state card"><h2>No sensors yet</h2><p>Link your first sensor to start monitoring.</p><a class="btn btn-primary" data-discover="true" href="/add-sensor">Add Sensor</a></section>"`;

exports[`Dashboard > renders the same safe page in English and Arabic 1`] = `"<div class="dashboard"><div class="device-pills"><button aria-pressed="true" class="device-pill pill-safe" type="button"><span class="dot" style="background: var(--safe-dot);"></span><span class="pill-name">Kitchen</span><span class="pill-ppm">120</span></button><button aria-pressed="false" class="device-pill pill-offline" type="button"><span class="dot" style="background: var(--text-faint);"></span><span class="pill-name">A4:CF:12:3B:9E:7F</span><span class="pill-ppm">1,300</span></button><a class="device-pill pill-add" data-discover="true" href="/add-sensor">+ Add Sensor</a></div><section class="status-hero hero-safe"><div><div class="hero-device" style="color: var(--safe-ink);"><span class="dot " style="background: var(--safe-ink);"></span>Kitchen · Floor 1</div><h2 class="hero-word" style="color: var(--safe-ink);">SAFE</h2><p class="hero-message">No gas leak detected</p><p class="hero-advice">Readings are well below the alarm threshold.</p></div><div class="gauge"><svg aria-label="120 ppm" role="img" viewBox="0 0 200 116"><path class="gauge-track" d="M20 100 A80 80 0 0 1 180 100"></path><path class="gauge-value" d="M20 100 A80 80 0 0 1 180 100" style="stroke: var(--safe-ink); stroke-dasharray: 16.8 400;"></path><line class="gauge-tick" x1="111.80807608135127" x2="115.9756323453576" y1="33.03307279516986" y2="9.397686722876855"></line></svg><div class="gauge-reading"><div class="gauge-number">120</div><div class="gauge-unit">ppm (estimated)</div></div><div class="gauge-scale" dir="ltr"><span>0</span><span>1,800</span></div><div class="gauge-threshold"><span class="gauge-threshold-mark"></span>Threshold 1,000 ppm</div></div></section><div class="info-cards"><div class="card info-card"><div class="info-label">Sensor Status</div><div class="info-title"><span class="dot" style="background: var(--safe-dot);"></span>Online</div><dl class="info-list"><dt>MAC address</dt><dd class="mono" dir="ltr">A4:CF:12:3B:9E:01</dd><dt>Last reading</dt><dd dir="ltr">11:59:00</dd></dl></div><div class="card info-card "><div class="info-label">Alerts</div><div class="info-title" style="color: var(--safe-ink);">No active alerts</div><p class="info-body">Everything looks normal.</p><a data-discover="true" href="/history">View history and alerts</a></div></div><section class="card readings-card"><div class="readings-head"><h3>Recent Readings</h3><span>Last 2 readings</span><span class="legend"><span class="legend-line"></span>Threshold 1,000 ppm</span></div><div class="chart" dir="ltr"><div class="recharts-responsive-container" style="width: 100%; height: 260px; min-width: 0px;"><div style="width: 0px; overflow-x: visible;"></div></div></div><p class="estimate-note">Values are estimates. The sensor has not been calibrated against a reference instrument yet.</p></section></div>"`;

exports[`Dashboard > renders the same safe page in English and Arabic 2`] = `"<div class="dashboard"><div class="device-pills"><button aria-pressed="true" class="device-pill pill-safe" type="button"><span class="dot" style="background: var(--safe-dot);"></span><span class="pill-name">Kitchen</span><span class="pill-ppm">120</span></button><button aria-pressed="false" class="device-pill pill-offline" type="button"><span class="dot" style="background: var(--text-faint);"></span><span class="pill-name">A4:CF:12:3B:9E:7F</span><span class="pill-ppm">1,300</span></button><a class="device-pill pill-add" data-discover="true" href="/add-sensor">+ إضافة حساس</a></div><section class="status-hero hero-safe"><div><div class="hero-device" style="color: var(--safe-ink);"><span class="dot " style="background: var(--safe-ink);"></span>Kitchen · Floor 1</div><h2 class="hero-word" style="color: var(--safe-ink);">آمن</h2><p class="hero-message">لا يوجد تسرّب غاز</p><p class="hero-advice">القراءات أقل بكثير من حد الإنذار.</p></div><div class="gauge"><svg aria-label="120 ppm" role="img" viewBox="0 0 200 116"><path class="gauge-track" d="M20 100 A80 80 0 0 1 180 100"></path><path class="gauge-value" d="M20 100 A80 80 0 0 1 180 100" style="stroke: var(--safe-ink); stroke-dasharray: 16.8 400;"></path><line class="gauge-tick" x1="111.80807608135127" x2="115.9756323453576" y1="33.03307279516986" y2="9.397686722876855"></line></svg><div class="gauge-reading"><div class="gauge-number">120</div><div class="gauge-unit">جزء في المليون (تقديري)</div></div><div class="gauge-scale" dir="ltr"><span>0</span><span>1,800</span></div><div class="gauge-threshold"><span class="gauge-threshold-mark"></span>الحد 1,000 ppm</div></div></section><div class="info-cards"><div class="card info-card"><div class="info-label">حالة الحساس</div><div class="info-title"><span class="dot" style="background: var(--safe-dot);"></span>متصل</div><dl class="info-list"><dt>عنوان MAC</dt><dd class="mono" dir="ltr">A4:CF:12:3B:9E:01</dd><dt>آخر قراءة</dt><dd dir="ltr">11:59:00</dd></dl></div><div class="card info-card "><div class="info-label">التنبيهات</div><div class="info-title" style="color: var(--safe-ink);">لا توجد تنبيهات نشطة</div><p class="info-body">كل شيء طبيعي.</p><a data-discover="true" href="/history">عرض السجل والتنبيهات</a></div></div><section class="card readings-card"><div class="readings-head"><h3>القراءات الأخيرة</h3><span>آخر 2 قراءة</span><span class="legend"><span class="legend-line"></span>الحد 1,000 ppm</span></div><div class="chart" dir="ltr"><div class="recharts-responsive-container" style="width: 100%; height: 260px; min-width: 0px;"><div style="width: 0px; overflow-x: visible;"></div></div></div><p class="estimate-note">القيم تقديرية. لم تتم معايرة الحساس مقابل جهاز مرجعي بعد.</p></section></div>"`;

exports[`Dashboard > shows an open alert with its start and peak 1`] = `"<div class="card info-card alert-active"><div class="info-label">Alerts</div><div class="info-title" style="color: var(--danger-ink);">Alarm active</div><p class="info-body">Started 11:30:00 · peak 1,450 ppm</p><a data-discover="true" href="/history">View history and alerts</a></div>"`;

exports[`Dashboard > switches device from its pill, and an offline alarming device shows offline 1`] = `"<section class="status-hero hero-offline"><div><div class="hero-device" style="color: var(--offline-ink);"><span class="dot " style="background: var(--offline-ink);"></span>A4:CF:12:3B:9E:7F</div><h2 class="hero-word" style="color: var(--offline-ink);">OFFLINE</h2><p class="hero-message">This sensor is not reporting</p><p class="hero-advice">Check the power and Wi-Fi connection. Showing the last known reading.</p></div><div class="gauge"><svg aria-label="1300 ppm" role="img" viewBox="0 0 200 116"><path class="gauge-track" d="M20 100 A80 80 0 0 1 180 100"></path><path class="gauge-value" d="M20 100 A80 80 0 0 1 180 100" style="stroke: var(--offline-ink); stroke-dasharray: 181.5 400;"></path><line class="gauge-tick" x1="111.80807608135127" x2="115.9756323453576" y1="33.03307279516986" y2="9.397686722876855"></line></svg><div class="gauge-reading"><div class="gauge-number">1,300</div><div class="gauge-unit">ppm (estimated)</div></div><div class="gauge-scale" dir="ltr"><span>0</span><span>1,800</span></div><div class="gauge-threshold"><span class="gauge-threshold-mark"></span>Threshold 1,000 ppm</div></div></section>"`;

exports[`Dashboard > switches device from its pill, and an offline alarming device shows offline 2`] = `"MAC addressA4:CF:12:3B:9E:7FLast reading19 Nov, 08:00:00"`;

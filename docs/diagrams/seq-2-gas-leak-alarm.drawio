c2" value="1. Analog voltage (high)" style="fontFamily=Helvetica;html=1;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;fontSize=12;strokeColor=#333333;fontColor=#333333;endSize=8;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="117.5" y="246" as="sourcePoint"/><mxPoint x="292.5" y="246" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c3" value="" style="fontFamily=Helvetica;html=1;endArrow=block;endFill=1;strokeColor=#C62828;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="292.5" y="282" as="sourcePoint"/><mxPoint x="292.5" y="304" as="targetPoint"/><Array as="points"><mxPoint x="327.5" y="282"/><mxPoint x="327.5" y="304"/></Array></mxGeometry></mxCell><mxCell id="c4" value="2. lpg_ppm_est ≥ threshold_ppm" style="fontFamily=Helvetica;text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#C62828;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="337.5" y="278" width="216" height="30" as="geometry"/></mxCell><mxCell id="c5" value="LOCAL ALARM — decided on the device, works without internet (O2)" style="fontFamily=Helvetica;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50.0" y="318" width="485.0" height="32" as="geometry"/></mxCell><mxCell id="c6" value="3. Turn ON buzzer + LED" style="fontFamily=Helvetica;html=1;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;fontSize=12;strokeColor=#C62828;fontColor=#C62828;endSize=8;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="292.5" y="390" as="sourcePoint"/><mxPoint x="467.5" y="390" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c7" value="4. PUBLISH aqms/devices/{mac}/alarms {event: alarm_on, lpg_ppm_est, threshold_ppm, ts}" style="fontFamily=Helvetica;html=1;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;fontSize=12;strokeColor=#C62828;fontColor=#C62828;endSize=8;endArrow=block;endFill
Point"/><mxPoint x="1342.5" y="716" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c13" value="9. Created (a repeated alarm_on is ignored: one open alert per device)" style="fontFamily=Helvetica;html=1;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;fontSize=12;strokeColor=#2E7D32;fontColor=#2E7D32;endSize=8;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1342.5" y="762" as="sourcePoint"/><mxPoint x="992.5" y="762" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="10. Emit alert:new → room user:{ownerId}" style="fontFamily=Helvetica;html=1;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;fontSize=12;strokeColor=#1565C0;fontColor=#1565C0;endSize=8;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="992.5" y="808" as="sourcePoint"/><mxPoint x="1517.5" y="808" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="11. Web alert (owner's room only)" style="fontFamily=Helvetica;html=1;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;fontSize=12;strokeColor=#1565C0;fontColor=#1565C0;endSize=8;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1517.5" y="854" as="sourcePoint"/><mxPoint x="1692.5" y="854" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" value="" style="fontFamily=Helvetica;html=1;endArrow=block;endFill=1;strokeColor=#C62828;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1692.5" y="890" as="sourcePoint"/><mxPoint x="1692.5" y="912" as="targetPoint"/><Array as="points"><mxPoint x="1727.5" y="890"/><mxPoint x="1727.5" y="912"/></Array></mxGeometry></mxCell><mxCell id="c17" value="12. Show red alert banner + add to alert history" style="fontFamily=Helvetica;text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#C62828;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1737.5" y="886" width="345" height="30" as="geometry"/></mxCell><mxCell id="c18" value="13. UPDATE alert_events SET ended_at = ts WHERE device_id = $1 AND ended_at IS NULL" style="fontFamily=Helvetica;html=1;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;fontSize=12;strokeColor=#2E7D32;fontColor=#2E7D32;endSize=8;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="992.5" y="984" as="sourcePoint"/><mxPoint x="1342.5" y="984" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="14. Emit alert:new (ended) → room user:{ownerId}" style="fontFamily=Helvetica;html=1;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;fontSize=12;strokeColor=#1565C0;fontColor=#1565C0;endSize=8;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="992.5" y="1030" as="sourcePoint"/><mxPoint x="1517.5" y="1030" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c20" value="" style="fontFamily=Helvetica;html=1;endArrow=block;endFill=1;strokeColor=#333333;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1692.5" y="1066" as="sourcePoint"/><mxPoint x="1692.5" y="1088" as="targetPoint"/><Array as="points"><mxPoint x="1727.5" y="1066"/><mxPoint x="1727.5" y="1088"/></Array></mxGeometry></mxCell><mxCell id="c21" value="15. Close banner; history shows start and end time" style="fontFamily=Helvetica;text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1737.5" y="1062" width="360" height="30" as="geometry"/></mxCell><mxCell id="c22" value="alt" style="fontFamily=Helvetica;shape=umlFrame;whiteSpace=wrap;html=1;width=60;height=24;fillColor=none;strokeColor=#7E57C2;dashed=1;fontStyle=1;fontColor=#4527A0;swimlaneFillColor=none;" vertex="1" parent="1"><mxGeometry x="917.0" y="646" width="851.0" height="460" as="geometry"/></mxCell><mxCell id="c23" value="[event = alarm_on]" style="fontFamily=Helvetica;text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#4527A0;" vertex="1" parent="1"><mxGeometry x="1092.5" y="648" width="500" height="22" as="geometry"/></mxCell><mxCell id="c24" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#7E57C2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="917.0" y="930" as="sourcePoint"/><mxPoint x="1768.0" y="930" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="[event = alarm_off  (lpg_ppm_est dropped below threshold_ppm)]" style="fontFamily=Helvetica;text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#4527A0;" vertex="1" parent="1"><mxGeometry x="1092.5" y="932" width="500" height="22" as="geometry"/></mxCell><mxCell id="c26" value="Buzzer + LED keep working locally" style="fontFamily=Helvetica;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="225.0" y="1174" width="310.0" height="32" as="geometry"/></mxCell><mxCell id="c27" value="" style="fontFamily=Helvetica;html=1;endArrow=block;endFill=1;strokeColor=#333333;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="642.5" y="1236" as="sourcePoint"/><mxPoint x="642.5" y="1258" as="targetPoint"/><Array as="points"><mxPoint x="677.5" y="1236"/><mxPoint x="677.5" y="1258"/></Array></mxGeometry></mxCell><mxCell id="c28" value="16. Keep-alive timeout → publish Last Will (LWT)" style="fontFamily=Helvetica;text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="687.5" y="1232" width="345" height="30" as="geometry"/></mxCell><mxCell id="c29" value="17. aqms/devices/{mac}/status {state: offline} (retained)" style="fontFamily=Helvetica;html=1;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;fontSize=12;strokeColor=#333333;fontColor=#333333;endSize=8;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="642.5" y="1